# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security
# Set this to a comma-separated list of origins allowed to make requests to this backend
CORS_ORIGINS=https://phone-erp.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Supabase (PostgreSQL Database)
SUPABASE_URL=your-supabase-url-here
# Backward-compatible public/legacy key. The backend prefers the service-role key below.
SUPABASE_KEY=your-supabase-anon-key-here
# Render only: copy the Supabase service_role key. Never add this to Vercel/NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Customer portal (Render only). Use a long random value and keep it stable.
CUSTOMER_PORTAL_SIGNING_SECRET=replace-with-a-long-random-secret

# Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key-here
ENABLE_LLM_FALLBACK=true
ENABLE_LLM_TRANSLITERATION=false
BUSINESS_ALIAS_MODE=off

# Meta WhatsApp Cloud API (Render only)
META_WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
META_WHATSAPP_WABA_ID=replace-with-waba-id
META_WHATSAPP_VERIFY_TOKEN=replace-with-random-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_DEFAULT_SHOP_ID=
# Keep false when whatsapp_connections contains the production number mapping.
META_WHATSAPP_ALLOW_DEFAULT_CONNECTION_FALLBACK=false
META_WHATSAPP_MAX_WEBHOOK_BYTES=1048576
META_WHATSAPP_MAX_MEDIA_BYTES=15728640
META_WHATSAPP_WORKER_BATCH_SIZE=10
META_WHATSAPP_WORKER_POLL_SECONDS=2
META_WHATSAPP_RETRY_BASE_SECONDS=30

# Multi-business Embedded Signup (Render only)
# Keep disabled until SQL 025 is applied and Meta Embedded Signup is configured.
META_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# Supervised pilot shop UUIDs, comma-separated. Use * only after public approval.
META_WHATSAPP_EMBEDDED_SIGNUP_ALLOWED_SHOP_IDS=
META_APP_ID=replace-with-meta-app-id
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=replace-with-embedded-signup-config-id
# URL-safe base64 value that decodes to exactly 32 random bytes.
META_WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-generated-encryption-key
META_WHATSAPP_TOKEN_KEY_VERSION=1
